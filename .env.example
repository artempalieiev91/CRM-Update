# CRM Update — environment for deploy (copy to the server, do not commit secrets)
#
# UI
CRM_UPDATE_STREAMLIT_PORT=8501
#
# IDS health (CodeIT short/long tests)
CRM_UPDATE_HEALTH_HOST=0.0.0.0
CRM_UPDATE_HEALTH_PORT=8502
CRM_UPDATE_HEALTH_API_KEY=change-me-before-production
#
# Marker file: "OK" or "ERROR: …" / "WARNING: …"
# Default: <project>/.crm_update_workspace/status.marker
# CRM_UPDATE_MARKER_PATH=/var/log/crm-update/status.marker
#
# Optional file log (stdout is always on)
# CRM_UPDATE_LOG_FILE=/var/log/crm-update/crm-update.log
#
# Long test always checks disk. Skip Google HTTPS only if IT agrees:
# CRM_UPDATE_LONG_TEST_SKIP_GOOGLE=0
